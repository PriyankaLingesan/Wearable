digraph G {
graph [fontname="Helvetica",rankdir=LR,pad=0.3,nodesep=0.35,ranksep=0.5]; node [fontname="Helvetica",shape=box,style="rounded,filled",fillcolor="#EEF3FA",color="#2F5D8C",fontsize=11]; edge [fontname="Helvetica",fontsize=9,color="#555555"];

all [label="Manifest\n240 items / 1440 images"]; dev [label="Dev = train+val items"]; test [label="Test items (never used\nfor selection, thresholds, calibration)",fillcolor="#FDECEA",color="#C62828"]; cv [label="GroupKFold by item\nmodel selection + OOF scores"]; fit [label="Refit on dev\nfinal models"]; ev [label="Evaluate once on test\ncluster bootstrap CI (item level)"]; loso [label="Leave-one-source-out\ngeneralisation (S1/S2/S3)"];
all->dev; all->test; dev->cv->fit->ev; test->ev; all->loso;
}
