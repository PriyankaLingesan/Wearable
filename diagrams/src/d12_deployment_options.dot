digraph G {
graph [fontname="Helvetica",rankdir=LR,pad=0.3,nodesep=0.35,ranksep=0.5]; node [fontname="Helvetica",shape=box,style="rounded,filled",fillcolor="#EEF3FA",color="#2F5D8C",fontsize=11]; edge [fontname="Helvetica",fontsize=9,color="#555555"];

rankdir=TB;
a [label="A. Wrist unit only\nPi Zero 2 W-class\n512 MB RAM design target\nmeasured peak RSS ~176 MB (x86 sandbox)\nlatency NOT measured on Pi"]; b [label="B. Wrist unit + companion offload\n(recommended design)\nframe/ROI sent to phone or laptop\nwrist handles capture and display"]; c [label="C. Smartphone app only\nno dedicated wearable"]; d [label="D. Laptop / server\nbest compute, not wearable"];
sel [label="Selected: B (with A as fallback)\nrationale: RAM headroom, unmeasured Pi latency,\nCSI camera min-focus limits",shape=note,fillcolor="#E4F4E4",color="#2E7D32"];
a->sel; b->sel; c->sel [style=dashed]; d->sel [style=dashed];
}
