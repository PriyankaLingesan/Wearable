digraph G {
graph [fontname="Helvetica",rankdir=LR,pad=0.3,nodesep=0.35,ranksep=0.5]; node [fontname="Helvetica",shape=box,style="rounded,filled",fillcolor="#EEF3FA",color="#2F5D8C",fontsize=11]; edge [fontname="Helvetica",fontsize=9,color="#555555"];

ui [label="Browser UI\n(index.html)"]; api [label="Flask app.py\n/api/capture  /api/analyze  /api/health"]; syn [label="synth.render_acquisition\n(simulated camera)"]; hw [label="sim_hw\nLED effect, OLED bitmap"]; pipe [label="REAL pipeline\npipeline.analyse + models"]; mod [label="models/*.joblib\ndeployment.json",shape=cylinder];
ui->api; api->syn; syn->pipe; api->pipe [label="uploaded image"]; mod->pipe; pipe->hw; hw->api; api->ui [label="decision, OLED PNG,\ntimings, ground truth (synthetic only)"];
}
